DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# App server
SERVER_PORT=

FRONTEND_PORT=

OPENROUTER_API_KEY=

# Observability
# ENV labels traces/logs with the deployment environment (default: dev)
ENV=
# LOG_LEVEL: debug | info | warn | error (default: info)
LOG_LEVEL=
# LOG_FORMAT: json | text (default: json)
# Leave as json in Compose: the OTel collector parses each stdout line as JSON
# to promote level/service/request_id into Loki labels. Use text only when
# running the backend directly in a terminal.
LOG_FORMAT=
GRAFANA_PORT=
GRAFANA_USER=
GRAFANA_PASSWORD=
